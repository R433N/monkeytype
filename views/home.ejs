<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MonkeyCode</title>
    <link rel="stylesheet" href="/styles/styles.css">
</head>
<body>
    <main>
        <nav id="header">
        
            <!-- <div id="button"> -->
                <h1 id="logo">MonkeyCode</h1>
            
                <select id="language">
                    <option value="python">Python</option>
                    <option value="java">Java</option>
                    <option value="cpp">C++</option>
                </select>
                <select id="difficulty">
                    <option value="beginner">Beginner</option>
                    <option value="intermediate">Intermediate</option>
                    <option value="advanced">Advanced</option>
                </select>
                
                <button id="newGame">New Game</button>
                <button id="pasteCode">Paste</button>

            <!-- </div> -->
        </nav>
        <div id="info">0s</div>
    
    <div id="game" tabindex="0">
    <div id="code"></div>
    <textarea id="editor" spellcheck="false" maxlength="5000"
        placeholder="Paste or type the code you want to practice..."></textarea>
    <div id="focus-error">Click here to focus</div>
    </div>
    <section id="results">
        <div id="stat-cards">
            <div class="stat-card">
                <span class="stat-value" id="stat-wpm">0</span>
                <span class="stat-label">wpm</span>
            </div>
            <div class="stat-card">
                <span class="stat-value" id="stat-accuracy">0%</span>
                <span class="stat-label">accuracy</span>
            </div>
            <div class="stat-card">
                <span class="stat-value" id="stat-time">0s</span>
                <span class="stat-label">time</span>
            </div>
        </div>

        <div id="result-links">
            <button class="link-button" id="playAgain">play again</button>
            <button class="link-button" id="login">login to save progress</button>
        </div>

        <p id="restart-hint"><kbd>tab</kbd> → restart</p>
    </section>

    <div id="editor-actions">
        <button id="confirmCode" title="Start typing this code">✓</button>
        <button id="clearCode" title="Clear the box">✕</button>
    </div>
</main>
    <script type="module"
    src="../javascript/typing.js"></script>
    
</body>
</html>