<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MonkeyCode</title>
    <link rel="stylesheet" href="/styles/styles.css">
</head>
<body>
    <main>
        <h1 id="logo">MonkeyCode</h1>
        <div id="header">
        <div id="info">0s</div>
        <div id="button">
           
            <select id="language">
                <option value="python">Python</option>
                <option value="java">Java</option>
                <option value="cpp">C++</option>
            </select>
            <select id="difficulty">
                <option value="beginner">Beginner</option>
                <option value="intermediate">Intermediate</option>
                <option value="advanced">Advanced</option>
            </select>
            
            <button>New Game</button>
            <button id="pasteCode">Paste Your Own Code</button>

        </div>
    </div>
    
    <div id="game" tabindex="0">
    <div id="code"></div>
    <textarea id="editor" spellcheck="false" maxlength="5000"
        placeholder="Paste or type the code you want to practice..."></textarea>
    <div id="focus-error">Click here to focus</div>
    </div>

    <div id="editor-actions">
        <button id="confirmCode" title="Start typing this code">✓</button>
        <button id="clearCode" title="Clear the box">✕</button>
    </div>
</main>
    <script type="module"
    src="../javascript/typing.js"></script>
    
</body>
</html>